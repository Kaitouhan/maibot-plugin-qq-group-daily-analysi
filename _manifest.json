{
  "manifest_version": 2,
  "id": "kaitouhan.qq-group-daily-analysis",
  "version": "1.0.0",
  "name": "群聊日常分析",
  "description": "AstrBot 群分析完整引擎的 MaiBot 1.3.15 移植：日报、漫画、增量、模板、追踪与原生管理后台",
  "author": {
    "name": "Kaitouhan",
    "url": "https://github.com/Kaitouhan"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Kaitouhan/maibot-plugin-qq-group-daily-analysi"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.15"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "capabilities": [
    "send.text",
    "send.image",
    "chat.get_group_streams",
    "message.get_by_time_in_chat",
    "llm.generate",
    "render.html2png",
    "send.forward",
    "send.custom",
    "chat.get_avatar",
    "config.get",
    "api.call",
    "webui.claim_upload"
  ],
  "dependencies": [],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
